# Auditoria System - Configuración del agente

# Intervalo entre comprobaciones, en segundos.
AUDITORIA_INTERVAL=10

# Estado persistente del agente.
AUDITORIA_STATE_DIR=/var/lib/auditoria-system

# Registro estructurado de eventos.
AUDITORIA_LOG_DIR=/var/log/auditoria-system

# Duración de sesión web en segundos (8 horas por defecto).
AUDITORIA_AUTH_SESSION_SECONDS=28800

# Cambiar a true únicamente cuando la API se sirva mediante HTTPS.
AUDITORIA_AUTH_COOKIE_SECURE=false

# URL pública alcanzable por los servidores que se registrarán como agentes.
# Debe usar http:// o https://; no se infiere desde la solicitud web.
AUDITORIA_CENTRAL_URL=https://auditoria.example

# Base de datos central de eventos sincronizados.
AUDITORIA_CENTRAL_DB=/var/lib/auditoria-system-central/central.db

# Identidad instalada por el comando de registro. Contiene secretos y debe
# permanecer con permisos 0600; no copie la credential a este archivo env.
AUDITORIA_AGENT_IDENTITY_FILE=/etc/auditoria-system/agent-identity.json

# Sincronización persistente del outbox local hacia el central.
AUDITORIA_SYNC_INTERVAL=10
AUDITORIA_SYNC_TIMEOUT_SECONDS=5
AUDITORIA_SYNC_BATCH_SIZE=50
AUDITORIA_SYNC_RETRY_BASE_SECONDS=5
AUDITORIA_SYNC_RETRY_MAX_SECONDS=300

# Presencia central derivada exclusivamente de heartbeats autenticados.
AUDITORIA_HEARTBEAT_INTERVAL=30
AUDITORIA_AGENT_OFFLINE_AFTER_SECONDS=120

# Notificaciones: desactivadas hasta configurar un dominio verificado y API key.
AUDITORIA_NOTIFICATIONS_ENABLED=false
AUDITORIA_NOTIFICATION_MIN_SEVERITY=high
AUDITORIA_NOTIFICATION_PROVIDER=resend
# Configurar cuando exista un dominio verificado en Resend.
AUDITORIA_RESEND_API_KEY=
AUDITORIA_NOTIFICATION_FROM=
AUDITORIA_NOTIFICATION_TO=
AUDITORIA_RESEND_API_URL=https://api.resend.com/emails
AUDITORIA_NOTIFICATION_TIMEOUT_SECONDS=5
